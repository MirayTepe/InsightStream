# InsightStream Environment Variables
# Copy to .env and fill in your values

# App
PROJECT_NAME=InsightStream
API_V1_PREFIX=/api/v1
ENVIRONMENT=dev
DEBUG=false
MAX_UPLOAD_SIZE_MB=50

# CORS (comma-separated URLs, or leave empty for defaults)
# BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/insightstream
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/insightstream

# Redis
REDIS_URL=redis://localhost:6379/0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672//

# JWT / Auth
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Cloud / Vertex AI
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# Free Gemini (API-key) access (ai.google.dev)
GOOGLE_API_KEY=
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2-preview

VERTEX_TEXT_EMBEDDING_MODEL=text-embedding-004
VERTEX_FLASH_MODEL=gemini-flash-latest
VERTEX_PRO_MODEL=gemini-pro-latest

# Text-to-Speech
TTS_VOICE_NAME=en-US-Neural2-C
TTS_LANGUAGE_CODE=en-US

# RAG
RAG_DEFAULT_TOP_K=5
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=200

# Vector storage
VECTOR_STORE_TYPE=faiss
FAISS_INDEX_PATH=./data/faiss

# Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/uploads
S3_BUCKET_NAME=

# Rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_ENABLED=true

# Observability
PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO
